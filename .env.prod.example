# 复制为 .env.prod 后修改（不要提交 .env.prod）
# cp .env.prod.example .env.prod

# ---------- 对外访问 ----------
# 宿主机 HTTP 端口（轻量默认 80）
HTTP_PORT=80
# 浏览器实际访问来源，多个用英文逗号分隔
# 例：http://1.2.3.4  或  http://gsms.example.com,https://gsms.example.com
CORS_ALLOWED_ORIGINS=http://替换为你的公网IP或域名

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=请换成强密码_root
MYSQL_DATABASE=gsms
MYSQL_USER=gsms
MYSQL_PASSWORD=请换成强密码_gsms

# ---------- JWT ----------
# 至少 32 位随机串
JWT_SECRET=请换成随机长密钥_至少32位
JWT_EXPIRATION=86400000
